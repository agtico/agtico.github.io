+    void
+    testPositiveBalanceWithoutReserveLegacy()
+    {
+        testcase(
+            "Legacy 2.5.0 -- offer crossing creates positive balance without "
+            "reserve");
+
+        using namespace jtx;
+
+        Account const gw{"gateway"};
+        Account const alice{"alice"};
+        Account const market{"market"};
+        auto const USD = gw["USD"];
+        bool const aliceHigh = alice.id() > gw.id();
+
+        Env env{*this};
+        env.fund(XRP(100000), gw, alice, market);
+        env.close();
+
+        env(trust(alice, USD(1000)));
+        env(trust(market, USD(1000)));
+        env.close();
+
+        env(pay(gw, alice, USD(100)));
+        env(pay(gw, market, USD(1000)));
+        env.close();
+
+        env(fclear(gw, asfDefaultRipple));
+        env.close();
+
+        env(trust(alice, USD(0)));
+        env.close();
+        env(pay(alice, gw, USD(100)));
+        env.close();
+
+        auto const lineKey = keylet::line(alice.id(), USD.issue());
+        auto const cleared = env.le(lineKey);
+        if (!BEAST_EXPECT(cleared))
+            return;
+        BEAST_EXPECT(ownerCount(env, alice) == 0);
+        BEAST_EXPECT(!cleared->isFlag(
+            aliceHigh ? lsfHighReserve : lsfLowReserve));
+
+        env(offer(market, XRP(100), USD(100)));
+        env.close();
+
+        env(offer(alice, USD(50), XRP(50)));
+        env.close();
+
+        auto const crossed = env.le(lineKey);
+        if (!BEAST_EXPECT(crossed))
+            return;
+        BEAST_EXPECT(env.balance(alice, USD) == USD(50));
+        BEAST_EXPECT(ownerCount(env, alice) == 0);
+        BEAST_EXPECT(!crossed->isFlag(
+            aliceHigh ? lsfHighReserve : lsfLowReserve));
+    }
+
     void
     testWithFeats(FeatureBitset features)
     {
@@ -641,6 +699,7 @@ public:
         testExceedTrustLineLimit();
         testAuthFlagTrustLines();
         testTrustLineLimitsWithRippling();
