{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agtico.github.io/pft_indexing/schemas/pft-index-v0.schema.json",
  "title": "PFT Index Artifact v0",
  "type": "object",
  "required": ["schema", "kind", "index", "calculation", "provenance"],
  "properties": {
    "schema": {
      "const": "https://agtico.github.io/pft_indexing/schemas/pft-index-v0.schema.json"
    },
    "kind": {
      "const": "pft.index.v0"
    },
    "index": {
      "type": "object",
      "required": ["index_id", "name", "as_of_date", "base_currency", "publisher", "holdings"],
      "properties": {
        "index_id": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "as_of_date": { "type": "string", "format": "date" },
        "base_currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "shares_outstanding": { "type": "string" },
        "publisher": { "$ref": "#/$defs/publisher" },
        "source": { "type": "object" },
        "holdings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/holding" }
        }
      },
      "additionalProperties": true
    },
    "calculation": {
      "type": "object",
      "properties": {
        "weight_type": { "type": "string" },
        "total_market_value_base": { "type": "string" },
        "holdings_count": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["created_at", "created_by"],
      "properties": {
        "created_at": { "type": "string" },
        "created_by": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "publisher": {
      "type": "object",
      "required": ["pftl_address"],
      "properties": {
        "pftl_address": { "type": "string", "minLength": 1 },
        "network": { "type": "string" },
        "display_name": { "type": "string" },
        "wallet_role": { "type": "string" }
      },
      "additionalProperties": true
    },
    "holding": {
      "type": "object",
      "required": [
        "ticker",
        "canonical_name",
        "asset_class",
        "location",
        "currency",
        "market_currency",
        "quantity",
        "internal_shares",
        "price",
        "price_reference",
        "fx_rate_to_base",
        "market_value",
        "notional_value",
        "dollar_amount",
        "weight"
      ],
      "properties": {
        "ticker": { "type": "string", "minLength": 1 },
        "canonical_name": { "type": "string", "minLength": 1 },
        "sector": { "type": "string" },
        "asset_class": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "exchange": { "type": ["string", "null"] },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "market_currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "identifiers": {
          "type": "object",
          "properties": {
            "isin": { "type": "string" },
            "cusip": { "type": "string" },
            "figi": { "type": "string" },
            "coingecko_id": { "type": "string" },
            "contract_address": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        },
        "quantity": { "type": "string" },
        "internal_shares": { "type": "string" },
        "price": { "type": "string" },
        "price_reference": {
          "type": "object",
          "required": ["source_name", "source_type", "field", "as_of_date"],
          "properties": {
            "source_name": { "type": "string" },
            "source_type": { "type": "string" },
            "field": { "type": "string" },
            "as_of_date": { "type": "string" },
            "source_uri": { "type": "string" },
            "vendor_symbol": { "type": "string" },
            "data_point_id": { "type": "string" }
          },
          "additionalProperties": true
        },
        "fx_rate_to_base": { "type": "string" },
        "market_value": { "type": "string" },
        "notional_value": { "type": "string" },
        "dollar_amount": { "type": "string" },
        "weight": {
          "type": "object",
          "required": ["fraction", "percent", "basis_points"],
          "properties": {
            "fraction": { "type": "string" },
            "percent": { "type": "string" },
            "basis_points": { "type": "integer" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
